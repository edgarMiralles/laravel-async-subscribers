{
    "name": "edgarmiralles/laravel-async-subscribers",
    "description": "Auto-discovered, queued event subscribers for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/log": "^2.0|^3.0",
        "symfony/finder": "^7.2|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "EdgarMiralles\\AsyncSubscribers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdgarMiralles\\AsyncSubscribers\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@putenv XDEBUG_MODE=off",
            "pest"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "EdgarMiralles\\AsyncSubscribers\\AsyncSubscribersServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
